// Production Lark EBNF grammar for Block diagrams
// Ported from mermaid-js source (github.com/mermaid-js/mermaid)
//
// Examples:
//   block-beta
//     A["Module A"]
//     B["Module B"]
//     C["Module C"]
//     A --> B
//     B --> C
//
//   block-beta
//     columns 3
//     A["Step 1"]
//     B["Step 2"]
//     C["Step 3"]

?start: diagram

diagram: "block-beta"i statement*

statement: column_stmt
         | block_stmt
         | connection_stmt
         | space_stmt

// Column configuration
column_stmt: "columns"i NUMBER

// Block declarations
block_stmt: block_id "[" block_label "]"

block_id: IDENTIFIER

block_label: STRING

// Space/placeholder
space_stmt: "space"i

// Connections between blocks
connection_stmt: block_id ARROW_OP block_id ("|" LABEL_TEXT "|")?

ARROW_OP: "-->"
        | "<--"
        | "<-->"
        | "==="
        | "--x"
        | "o--"

// Terminals
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

STRING: /"[^"\\]*(?:\\.[^"\\]*)*"/
      | /'[^'\\]*(?:\\.[^'\\]*)*'/

LABEL_TEXT: /[^\|]+/

NUMBER: /\d+(\.\d+)?/

%import common.WS
%ignore WS
%ignore /%%.*$/m
