// Production Lark EBNF grammar for Sankey flow diagrams
// Ported from mermaid-js source (github.com/mermaid-js/mermaid)
//
// Examples:
//   sankey-beta
//     Source,Target,Value
//     Energy Source,Electricity Plant,100
//     Electricity Plant,Industrial,50
//     Electricity Plant,Residential,50
//
//   sankey-beta
//     A,B,10
//     B,C,5
//     A,C,3

?start: diagram

diagram: sankey_type flow*

sankey_type: "sankey"i | "sankey-beta"i

// Flow definition: source,target,value
flow: flow_source "," flow_target "," flow_value

flow_source: IDENTIFIER | STRING | FLOW_NODE

flow_target: IDENTIFIER | STRING | FLOW_NODE

flow_value: NUMBER

FLOW_NODE: /[a-zA-Z0-9_\s-]+/

// Terminals
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

STRING: /"[^"\\]*(?:\\.[^"\\]*)*"/
      | /'[^'\\]*(?:\\.[^'\\]*)*'/

NUMBER: /\d+(\.\d+)?/

%import common.WS
%ignore WS
%ignore /%%.*$/m
