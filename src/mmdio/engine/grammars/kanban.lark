// Production Lark EBNF grammar for Kanban diagrams
// Ported from mermaid-js source (github.com/mermaid-js/mermaid)
//
// Examples:
//   kanban
//     section To Do
//       Task A
//       Task B
//     section In Progress
//       Task C
//     section Done
//       Task D

?start: diagram

diagram: "kanban"i statement*

statement: section_stmt | card_stmt

// Section declaration
section_stmt: "section"i section_name

section_name: /[^\n]+/

// Card/task line
card_stmt: /[^\n]+/

// Terminals
%import common.WS
%ignore WS
%ignore /%%.*$/m
