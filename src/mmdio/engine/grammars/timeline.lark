// Production Lark EBNF grammar for Timeline diagrams
// Ported from mermaid-js source (github.com/mermaid-js/mermaid)
//
// Examples:
//   timeline
//     title Project Timeline
//     2024-01-01 : Phase 1 Start
//     2024-02-15 : Milestone A
//     2024-03-30 : Phase 2 Start
//
//   timeline
//     title Q1 2024
//     January : Planning
//     February : Development
//     March : Testing

?start: diagram

diagram: timeline_type timeline_title? event*

timeline_type: "timeline"i

timeline_title: "title"i TITLE_TEXT

TITLE_TEXT: /[^\n]+/

// Timeline event: date/period and description
// The key: split on the first colon on each line
event: EVENT_TIME ":" EVENT_DESC

EVENT_TIME: /[^\n:]+(?=\s*:)/

EVENT_DESC: /[^\n]+/

// Terminals
STRING: /"[^"\\]*(?:\\.[^"\\]*)*"/
      | /'[^'\\]*(?:\\.[^'\\]*)*'/

%import common.WS
%ignore WS
%ignore /%%.*$/m
