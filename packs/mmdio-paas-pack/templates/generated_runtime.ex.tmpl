{% endfor %}  @semantic_contract "PROV-O|DCTERMS|DCAT|SKOS|SHACL|R2RML"
  @command_identity "python:mmdio.engine.parse_mermaid+validate_topology+render_model"

  @python_adapter """
  import base64, json, sys
  from mmdio.engine import parse_mermaid, render_model, validate_topology

  source = base64.b64decode(sys.argv[1]).decode("utf-8")
  try:
      model = parse_mermaid(source)
      issues = validate_topology(model)
      if issues:
          print(json.dumps({"status": "REFUSED", "refusal_type": "TOPOLOGY", "issues": issues}, sort_keys=True))
          raise SystemExit(2)
      rendered = render_model(model)
      print(json.dumps({"status": "ALIVE", "model_type": type(model).__name__, "rendered": rendered}, sort_keys=True))
  except SystemExit:
      raise
  except Exception as exc:
      print(json.dumps({"status": "REFUSED", "refusal_type": "MERMAID_SEMANTICS", "error": str(exc)}, sort_keys=True))
      raise SystemExit(3)
  """

  @impl Reactor.Step
  def run(
        %{admitted: admitted, semantic_turtle: semantic_turtle, python: python},
        _context,
        _options
      ) do
    semantic_sha256 = MmdioPaaS.Receipt.sha256(semantic_turtle)

    case System.find_executable(python) do
      nil ->
        result =
          receipt_result(
            admitted,
            semantic_sha256,
            "BLOCKED",
            "PYTHON_EXECUTABLE",
            nil,
            nil,
            nil,
            "Python executable #{inspect(python)} is not available"
          )

        {:ok, result}

      executable ->
        execute(executable, admitted, semantic_sha256)
    end
  end

  defp execute(executable, admitted, semantic_sha256) do
    encoded = Base.encode64(admitted.source)

    try do
      {output, exit_code} =
        System.cmd(executable, ["-c", @python_adapter, encoded],
          stderr_to_stdout: true,
          env: [{"PYTHONHASHSEED", "0"}]
        )

      decoded = decode_output(output)
      rendered = Map.get(decoded, "rendered")
      status = Map.get(decoded, "status", if(exit_code == 0, do: "ALIVE", else: "BUILD_BROKEN"))
      refusal_type = Map.get(decoded, "refusal_type")

      result =
        receipt_result(
          admitted,
          semantic_sha256,
          status,
          refusal_type,
          rendered,
          exit_code,
          decoded,
          nil
        )

      {:ok, result}
    rescue
      exception ->
        result =
          receipt_result(
            admitted,
            semantic_sha256,
            "BUILD_BROKEN",
            "PYTHON_ADAPTER_EXCEPTION",
            nil,
            nil,
            nil,
            Exception.message(exception)
          )

        {:ok, result}
    end
  end

  defp decode_output(output) do
    line =
      output
      |> String.split("\n", trim: true)
      |> List.last()

    case line do
      nil ->
        %{}

      line ->
        case Jason.decode(line) do
          {:ok, decoded} -> decoded
          {:error, _} -> %{"status" => "BUILD_BROKEN", "refusal_type" => "NON_JSON_ADAPTER_OUTPUT"}
        end
    end
  end

  defp receipt_result(
         admitted,
         semantic_sha256,
         status,
         refusal_type,
         rendered,
         exit_code,
         adapter_payload,
         adapter_error
       ) do
    rendered_sha256 = if is_binary(rendered), do: MmdioPaaS.Receipt.sha256(rendered), else: nil

    receipt =
      MmdioPaaS.Receipt.seal(%{
        schema: "mmdio-paas-receipt/v1",
        status: status,
        refusal_type: refusal_type,
        subject_sha256: admitted.subject_sha256,
