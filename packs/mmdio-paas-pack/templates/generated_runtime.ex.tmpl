defmodule MmdioPaaS.Receipt do
  @moduledoc false

  @fields [
    :schema,
    :status,
    :refusal_type,
    :subject_sha256,
    :semantic_sha256,
    :rendered_sha256,
    :exit_code,
    :adapter,
    :command_identity,
    :ash_r2rml_ref,
    :ggen_ref,
    :semantic_contract
  ]

  def seal(fields) do
    normalized =
      @fields
      |> Map.new(fn key -> {key, Map.get(fields, key)} end)

    canonical =
      @fields
      |> Enum.map_join("\n", fn key ->
        "#{key}=#{canonical_value(Map.fetch!(normalized, key))}"
      end)

    Map.put(normalized, :receipt_sha256, sha256(canonical))
  end

  def sha256(value) when is_binary(value) do
    :crypto.hash(:sha256, value)
    |> Base.encode16(case: :lower)
  end

  defp canonical_value(nil), do: "-"
  defp canonical_value(value), do: to_string(value)
end

