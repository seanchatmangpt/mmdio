  only DO route; the bounded Python adapter always seals an attempted actuation in
  a receipt before returning. The Python engine remains the Mermaid semantic authority.
  """

  def render(source, content_type \\ "text/vnd.mermaid") do
    python = Application.get_env(:mmdio_paas, :python, "python3")

    case Reactor.run(MmdioPaaS.Workflow, %{
           source: source,
           content_type: content_type,
           python: python,
           resources: [MmdioPaaS.RenderRequest]
         }) do
      {:ok, result} ->
        {:ok, result}

      {:error, error} ->
        {:error, MmdioPaaS.ReactorDomainErrorNormalizer.normalize(error)}
    end
  end
end

