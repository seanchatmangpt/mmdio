defmodule MmdioPaaS.VerifyStep do
  @moduledoc false
  use Reactor.Step

  @impl Reactor.Step
  def run(%{result: result}, _context, _options) do
    expected =
      if is_binary(result.rendered),
        do: MmdioPaaS.Receipt.sha256(result.rendered),
        else: nil

    if expected == result.receipt.rendered_sha256 do
      {:ok, Map.put(result, :verified, true)}
    else
      {:error,
       %MmdioPaaS.Refusal{
         code: :receipt_verification_failed,
         message: "Rendered payload no longer matches the sealed receipt",
         evidence: %{expected: expected, receipt: result.receipt.rendered_sha256}
       }}
    end
  end
end

