PREFIX paas: <https://seanchatmangpt.github.io/ontology/mmdio/paas#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?violation WHERE { FILTER NOT EXISTS { paas:contentType rdfs:subPropertyOf dct:format . } BIND("CONTENT_TYPE_FORMAT" AS ?violation) }
