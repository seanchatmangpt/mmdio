PREFIX paas: <https://seanchatmangpt.github.io/ontology/mmdio/paas#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?violation WHERE { FILTER NOT EXISTS { paas:contentType rdfs:range xsd:string . } BIND("CONTENT_TYPE_RANGE" AS ?violation) }
