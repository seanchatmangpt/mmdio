---
to: "src/mmdio/engine/__init__.py"
force: true
sparql:
  models: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT DISTINCT ?className WHERE {
      ?type mer:pythonSupport true ; mer:hasModel ?model .
      ?model a mer:PythonModel ; mer:className ?className .
    } ORDER BY ?className
  enums: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT DISTINCT ?enumClassName WHERE {
      ?e a mer:PythonEnum ; mer:enumClassName ?enumClassName .
    } ORDER BY ?enumClassName
---
