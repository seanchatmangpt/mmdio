---
to: "src/mmdio/engine/models.py"
force: true
sparql:
  models: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT ?className (COALESCE(?top, false) AS ?isTopLevel) ?diagramId
           (COALESCE(?rebuild, false) AS ?modelRebuild) WHERE {
      ?type mer:pythonSupport true ; mer:pythonInternalId ?diagramId ; mer:hasModel ?model .
      ?model a mer:PythonModel ; mer:className ?className .
      OPTIONAL { ?model mer:isTopLevel ?top }
      OPTIONAL { ?model mer:modelRebuild ?rebuild }
    } ORDER BY ?className
  fields: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT ?className ?fieldOrder ?fieldName ?fieldKind ?fieldPyType
           (COALESCE(?desc, "") AS ?fieldDescription)
           (COALESCE(?d, "") AS ?fieldDefault) (COALESCE(?a, "") AS ?fieldValidationAlias) WHERE {
      ?model a mer:PythonModel ; mer:className ?className ; mer:field ?f .
      ?f mer:fieldOrder ?fieldOrder ; mer:fieldName ?fieldName ; mer:fieldKind ?fieldKind ; mer:fieldPyType ?fieldPyType .
      OPTIONAL { ?f mer:fieldDescription ?desc }
      OPTIONAL { ?f mer:fieldDefault ?d } OPTIONAL { ?f mer:fieldValidationAlias ?a }
    } ORDER BY ?className ?fieldOrder
  union_models: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT ?internalId ?modelClass WHERE { ?type mer:pythonSupport true ; mer:pythonInternalId ?internalId ; mer:pythonModelClass ?modelClass . } ORDER BY ?internalId
---
"""GENERATED FILE — do not edit by hand. Regenerate with `ggen sync run`."""
from __future__ import annotations
from typing import List, Literal, Optional
from pydantic import AliasChoices, BaseModel, ConfigDict, Field
from mmdio.engine.enums import *  # noqa: F401,F403

{% for model in models %}
class {{ model.className }}(BaseModel):
    model_config = ConfigDict(populate_by_name=True)
{% if model.isTopLevel %}    type: Literal["{{ model.diagramId }}"] = "{{ model.diagramId }}"
{% endif %}{% set fs = fields | filter(attribute="className", value=model.className) %}{% for f in fs %}{% if f.fieldValidationAlias %}{% set aa = ', validation_alias=AliasChoices("' ~ f.fieldName ~ '", "' ~ f.fieldValidationAlias ~ '")' %}{% else %}{% set aa = '' %}{% endif %}{% if f.fieldKind in ["scalar-required","nested-ref","enum"] %}    {{ f.fieldName }}: {{ f.fieldPyType }} = Field(..., description="{{ f.fieldDescription }}"{{ aa }})
{% elif f.fieldKind == "scalar-optional" %}    {{ f.fieldName }}: Optional[{{ f.fieldPyType }}] = Field(default=None, description="{{ f.fieldDescription }}"{{ aa }})
{% elif f.fieldKind in ["list","scalar-list","recursive-list"] %}    {{ f.fieldName }}: List[{{ f.fieldPyType }}] = Field(default_factory=list, description="{{ f.fieldDescription }}"{{ aa }})
{% elif f.fieldKind == "literal-default" %}    {{ f.fieldName }}: {{ f.fieldPyType }} = Field(default={{ f.fieldDefault }}, description="{{ f.fieldDescription }}"{{ aa }})
{% endif %}{% endfor %}
{% endfor %}
{% for model in models %}{% if model.modelRebuild %}{{ model.className }}.model_rebuild()
{% endif %}{% endfor %}
MermaidDiagram = ({% for row in union_models %}{{ row.modelClass }}{% if not loop.last %} | {% endif %}{% endfor %})
