---
to: "src/mmdio/engine/fixtures.py"
force: true
sparql:
  models: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT DISTINCT ?className (COALESCE(?top, false) AS ?isTopLevel) ?diagramId WHERE {
      ?type mer:pythonSupport true ; mer:pythonInternalId ?diagramId ; mer:hasModel ?model .
      ?model a mer:PythonModel ; mer:className ?className .
      OPTIONAL { ?model mer:isTopLevel ?top }
    } ORDER BY ?className
  fields: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT ?className ?fieldOrder ?fieldName ?fieldKind ?fieldPyType
           (COALESCE(?ex, "") AS ?fieldExampleValue) WHERE {
      ?model a mer:PythonModel ; mer:className ?className ; mer:field ?f .
      ?f mer:fieldOrder ?fieldOrder ; mer:fieldName ?fieldName ;
         mer:fieldKind ?fieldKind ; mer:fieldPyType ?fieldPyType .
      OPTIONAL { ?f mer:fieldExampleValue ?ex }
    } ORDER BY ?className ?fieldOrder
  top_models: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT ?diagramId ?modelClass WHERE {
      ?type mer:pythonSupport true ; mer:pythonInternalId ?diagramId ;
            mer:pythonModelClass ?modelClass .
    } ORDER BY ?diagramId
---
"""GENERATED FILE — do not edit by hand. Regenerate with `ggen sync run`.

One example_<internalId>() builder per top-level diagram model, built from the
mer:fieldExampleValue facts that gate 080 requires on every scalar-required and enum field.

Two-level depth by design: a list/nested-ref field's element type is populated from that
element model's own scalar and enum facts only. A list nested one level further in is left
at its Pydantic default, so the example stays valid without three-level recursion.
"""

from mmdio.engine.models import (
{% for model in models %}    {{ model.className }},
{% endfor %})
from mmdio.engine.enums import *  # noqa: F401,F403 — enum literals referenced below

{% for model in models %}{% if model.isTopLevel %}

def example_{{ model.diagramId }}() -> {{ model.className }}:
    """One representative {{ model.className }} built from ontology example values."""
    return {{ model.className }}({% set tf = fields | filter(attribute="className", value=model.className) %}{% for f in tf %}{% if f.fieldKind == "scalar-required" %}{{ f.fieldName }}={% if f.fieldPyType == "str" %}"{{ f.fieldExampleValue }}"{% else %}{{ f.fieldExampleValue }}{% endif %}, {% elif f.fieldKind == "enum" %}{{ f.fieldName }}={{ f.fieldPyType }}.{{ f.fieldExampleValue }}, {% elif f.fieldKind == "list" %}{{ f.fieldName }}=[{{ f.fieldPyType }}({% set ef = fields | filter(attribute="className", value=f.fieldPyType) %}{% for e in ef %}{% if e.fieldKind == "scalar-required" %}{{ e.fieldName }}={% if e.fieldPyType == "str" %}"{{ e.fieldExampleValue }}"{% else %}{{ e.fieldExampleValue }}{% endif %}, {% elif e.fieldKind == "enum" %}{{ e.fieldName }}={{ e.fieldPyType }}.{{ e.fieldExampleValue }}, {% endif %}{% endfor %})], {% elif f.fieldKind == "nested-ref" %}{{ f.fieldName }}={{ f.fieldPyType }}({% set nf = fields | filter(attribute="className", value=f.fieldPyType) %}{% for e in nf %}{% if e.fieldKind == "scalar-required" %}{{ e.fieldName }}={% if e.fieldPyType == "str" %}"{{ e.fieldExampleValue }}"{% else %}{{ e.fieldExampleValue }}{% endif %}, {% elif e.fieldKind == "enum" %}{{ e.fieldName }}={{ e.fieldPyType }}.{{ e.fieldExampleValue }}, {% endif %}{% endfor %}), {% endif %}{% endfor %})
{% endif %}{% endfor %}

GENERATED_FIXTURE_MODEL_CLASSES = {
{% for row in top_models %}    "{{ row.diagramId }}": {{ row.modelClass }},
{% endfor %}}

GENERATED_FIXTURE_BUILDERS = {
{% for row in top_models %}    "{{ row.diagramId }}": example_{{ row.diagramId }},
{% endfor %}}
