force: true
sparql:
  models: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT ?className ?isTopLevel ?diagramId ?diagramHeaderKeyword WHERE {
      ?type mer:pythonInternalId ?diagramId ;
            mer:hasModel ?model .
      ?model a mer:PythonModel ;
             mer:className ?className ;
             mer:isTopLevel ?isTopLevel .
      OPTIONAL { ?model mer:diagramHeaderKeyword ?diagramHeaderKeyword }
    } ORDER BY ?className
  fields: |
    PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
    SELECT ?className ?fieldOrder ?fieldName ?fieldKind ?fieldPyType
           (COALESCE(?rf, "") AS ?fieldRenderFormat) WHERE {
      ?model a mer:PythonModel ;
             mer:className ?className ;
             mer:field ?f .
      ?f mer:fieldOrder ?fieldOrder ;
         mer:fieldName ?fieldName ;
         mer:fieldKind ?fieldKind ;
         mer:fieldPyType ?fieldPyType .
      OPTIONAL { ?f mer:fieldRenderFormat ?rf }
    } ORDER BY ?className ?fieldOrder
