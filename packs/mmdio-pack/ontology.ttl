@prefix mer: <https://seanchatmangpt.github.io/ontology/mermaid#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Python implementation metadata layered onto mer:Type_* subjects defined in
# src/mmdio/engine/registry.ttl (upstream-pinned, not edited by this pack).
#
# mer:pythonInternalId is the SHORT id used internally by
# mmdio.engine.parser's dispatch dicts, mmdio.detect's pattern list, and
# mmdio.engine.registry's _PYTHON_SUPPORTED set. It differs from
# mer:diagramId (the canonical upstream mermaid-js id) for exactly three
# types where mmdio's internal convention predates this pack:
#   classDiagram -> "class", stateDiagram -> "state", gitGraph -> "git"
# All other types use the same value for both.
#
# mer:pythonSupport true marks a type as ready for code generation; every
# such type MUST carry all eight mer:python*/mer:grammarFile/mer:detectPattern
# predicates below (enforced by gates/010_python_support_complete.rq).

mer:pythonSupport a rdf:Property .
mer:pythonInternalId a rdf:Property .
mer:pythonModelModule a rdf:Property .
mer:pythonModelClass a rdf:Property .
mer:pythonTransformerModule a rdf:Property .
mer:pythonTransformerClass a rdf:Property .
mer:pythonRenderModule a rdf:Property .
mer:pythonRenderFunction a rdf:Property .
mer:grammarFile a rdf:Property .
mer:detectPattern a rdf:Property .

# ============================================================================
# Field-shape matrix: mer:PythonModel / mer:PythonField
#
# Every diagram type's Pydantic AST decomposes into a small set of model
# classes (one top-level *Diagram class carrying the type discriminator,
# plus zero or more nested submodel classes it references), each with an
# ordered list of fields. Every field observed across the codebase — top-
# level and nested, across all agent-authored and hand-written model files
# — fits exactly one of six kinds. This is the closed vocabulary that the
# model-class, render-function, JSON-Schema, and fixture-builder templates
# all project from the same rows.
#
# mer:fieldKind (closed enum, enforced by gates/030_field_shape_closed_vocabulary.rq):
#   scalar-required | scalar-optional | list | nested-ref | union-type |
#   literal-default | enum
#
# "enum" fields are modeled identically to scalar-required for the Pydantic
# class template (Field(..., description=...), fieldPyType names the Enum
# class), but the fixture-builder template emits a bare `ClassName.MEMBER`
# literal instead of a quoted string (mer:fieldExampleValue on an enum
# field holds the MEMBER NAME, e.g. "SYNC", not the enum's string value).
# The Enum classes themselves are a separate, parallel matrix
# (mer:PythonEnum / mer:EnumMember) generated by
# templates/generated_enums.py.tmpl — one class per mer:hasEnum entry on a
# Type, one `NAME = "value"` line per member. Choosing the enum member's
# Python value to already equal the Mermaid render token (where the two
# coincide, as with sequence diagram participant types: "actor"/
# "participant" are both the semantic label AND the literal syntax token)
# means render's existing f-string substitution (`{_r1.field}`) already
# emits the correct token with no separate render-time lookup table needed
# — only true when token and label coincide; document per-enum if not.
#
# mer:fieldPyType is the BARE type (str, float | str, KanbanSection) —
# Optional[...]/List[...] wrapping is applied by templates based on
# fieldKind, never duplicated in the type string itself.
#
# mer:fieldRenderFormat is a Python f-string body (no outer f"..." quotes)
# used by the render-function template; required on every list-kind field
# (gates/050_render_format_present_for_list_fields.rq). Only list-kind
# fields carry a fieldRenderFormat — scalar fields are referenced inline
# inside their containing list field's format string. The render template
# names each nesting level's loop variable by depth: `_r1` for a list field
# directly on the top-level *Diagram model, `_r2` for a list field on the
# element model one level in, etc. (current templates support two levels,
# matching every type in the codebase — see gate 3 below for the limit).
#
# mer:fieldExampleValue seeds the fixture-builder template; empty string on
# list-kind fields (their examples come from the referenced element model's
# own fields, not a value on the list field itself).
# ============================================================================

mer:PythonModel a rdfs:Class .
mer:PythonField a rdfs:Class .
mer:PythonEnum a rdfs:Class .
mer:EnumMember a rdfs:Class .
mer:hasModel a rdf:Property .
mer:hasEnum a rdf:Property .
mer:enumClassName a rdf:Property .
mer:enumMember a rdf:Property .
mer:enumMemberName a rdf:Property .
mer:enumMemberValue a rdf:Property .
mer:enumMemberOrder a rdf:Property .
mer:className a rdf:Property .
mer:isTopLevel a rdf:Property .
mer:diagramHeaderKeyword a rdf:Property .
mer:field a rdf:Property .
mer:fieldOrder a rdf:Property .
mer:fieldName a rdf:Property .
mer:fieldKind a rdf:Property .
mer:fieldPyType a rdf:Property .
mer:fieldDescription a rdf:Property .
mer:fieldRenderFormat a rdf:Property .
mer:fieldExampleValue a rdf:Property .
mer:fieldDefault a rdf:Property .

# ----------------------------------------------------------------------------
# Kanban (worked example — transcribed from types/kanban_models.py,
# types/kanban_render.py, tests/oracle_types/test_oracle_kanban.py)
# ----------------------------------------------------------------------------

mer:Type_kanban mer:hasModel mer:Model_KanbanDiagram, mer:Model_KanbanSection, mer:Model_KanbanCard .

mer:Model_KanbanDiagram a mer:PythonModel ;
  mer:className "KanbanDiagram" ;
  mer:isTopLevel true ;
  mer:diagramHeaderKeyword "kanban" ;
  mer:field mer:Field_KanbanDiagram_sections .

mer:Field_KanbanDiagram_sections a mer:PythonField ;
  mer:fieldOrder 1 ;
  mer:fieldName "sections" ;
  mer:fieldKind "list" ;
  mer:fieldPyType "KanbanSection" ;
  mer:fieldDescription "List of Kanban sections/columns" ;
  mer:fieldRenderFormat "  section {_r1.name}" ;
  mer:fieldExampleValue "" .

mer:Model_KanbanSection a mer:PythonModel ;
  mer:className "KanbanSection" ;
  mer:isTopLevel false ;
  mer:field mer:Field_KanbanSection_name, mer:Field_KanbanSection_cards .

mer:Field_KanbanSection_name a mer:PythonField ;
  mer:fieldOrder 1 ;
  mer:fieldName "name" ;
  mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ;
  mer:fieldDescription "Section name (e.g., To Do, In Progress)" ;
  mer:fieldExampleValue "To Do" .

mer:Field_KanbanSection_cards a mer:PythonField ;
  mer:fieldOrder 2 ;
  mer:fieldName "cards" ;
  mer:fieldKind "list" ;
  mer:fieldPyType "KanbanCard" ;
  mer:fieldDescription "Cards in this section" ;
  mer:fieldRenderFormat "    {_r2.title}" ;
  mer:fieldExampleValue "" .

mer:Model_KanbanCard a mer:PythonModel ;
  mer:className "KanbanCard" ;
  mer:isTopLevel false ;
  mer:field mer:Field_KanbanCard_title .

mer:Field_KanbanCard_title a mer:PythonField ;
  mer:fieldOrder 1 ;
  mer:fieldName "title" ;
  mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ;
  mer:fieldDescription "Card title/task name" ;
  mer:fieldExampleValue "Task A" .

# ----------------------------------------------------------------------------
# Timeline (transcribed from types/timeline_models.py, types/timeline_render.py,
# tests/oracle_types/test_oracle_timeline.py)
# ----------------------------------------------------------------------------

mer:Type_timeline mer:hasModel mer:Model_TimelineDiagram, mer:Model_TimelineEvent .

mer:Model_TimelineDiagram a mer:PythonModel ;
  mer:className "TimelineDiagram" ;
  mer:isTopLevel true ;
  mer:diagramHeaderKeyword "timeline" ;
  mer:field mer:Field_TimelineDiagram_title, mer:Field_TimelineDiagram_events .

mer:Field_TimelineDiagram_title a mer:PythonField ;
  mer:fieldOrder 1 ;
  mer:fieldName "title" ;
  mer:fieldKind "scalar-optional" ;
  mer:fieldPyType "str" ;
  mer:fieldDescription "Optional timeline title" ;
  mer:fieldRenderFormat "    title {d.title}" ;
  mer:fieldExampleValue "Project Timeline" .

mer:Field_TimelineDiagram_events a mer:PythonField ;
  mer:fieldOrder 2 ;
  mer:fieldName "events" ;
  mer:fieldKind "list" ;
  mer:fieldPyType "TimelineEvent" ;
  mer:fieldDescription "List of timeline events" ;
  mer:fieldRenderFormat "    {_r1.time} : {_r1.description}" ;
  mer:fieldExampleValue "" .

mer:Model_TimelineEvent a mer:PythonModel ;
  mer:className "TimelineEvent" ;
  mer:isTopLevel false ;
  mer:field mer:Field_TimelineEvent_time, mer:Field_TimelineEvent_description .

mer:Field_TimelineEvent_time a mer:PythonField ;
  mer:fieldOrder 1 ;
  mer:fieldName "time" ;
  mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ;
  mer:fieldDescription "Event time/date (e.g., 2024-01-01, January, Q1)" ;
  mer:fieldExampleValue "2024-01-01" .

mer:Field_TimelineEvent_description a mer:PythonField ;
  mer:fieldOrder 2 ;
  mer:fieldName "description" ;
  mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ;
  mer:fieldDescription "Event description or label" ;
  mer:fieldExampleValue "Phase 1 Start" .

# ----------------------------------------------------------------------------
# Block (transcribed from types/block_models.py, types/block_render.py,
# tests/oracle_types/test_oracle_block.py)
#
# KNOWN GAP: block_render.py's hand-written Connection rendering is
# conditional on whether `label` is set (two different output lines). The
# render-format vocabulary is one fixed f-string per list element with no
# per-item branching, so the generated render_block() always emits the
# unlabeled form — connection labels exist on the model (round-trips fine
# via parse) but are not currently reproduced in generated render output.
# Documented here rather than silently dropped; a `conditional-format`
# field-kind would close this gap in a future pass.
# ----------------------------------------------------------------------------

mer:Type_block mer:hasModel mer:Model_BlockDiagram, mer:Model_Block, mer:Model_Connection .

mer:Model_BlockDiagram a mer:PythonModel ;
  mer:className "BlockDiagram" ;
  mer:isTopLevel true ;
  mer:diagramHeaderKeyword "block-beta" ;
  mer:field mer:Field_BlockDiagram_columns, mer:Field_BlockDiagram_blocks, mer:Field_BlockDiagram_connections .

mer:Field_BlockDiagram_columns a mer:PythonField ;
  mer:fieldOrder 1 ;
  mer:fieldName "columns" ;
  mer:fieldKind "scalar-optional" ;
  mer:fieldPyType "int" ;
  mer:fieldDescription "Optional column count for layout" ;
  mer:fieldRenderFormat "  columns {d.columns}" ;
  mer:fieldExampleValue "" .

mer:Field_BlockDiagram_blocks a mer:PythonField ;
  mer:fieldOrder 2 ;
  mer:fieldName "blocks" ;
  mer:fieldKind "list" ;
  mer:fieldPyType "Block" ;
  mer:fieldDescription "List of blocks in the diagram" ;
  mer:fieldRenderFormat "  {_r1.id}[\"{_r1.label}\"]" ;
  mer:fieldExampleValue "" .

mer:Field_BlockDiagram_connections a mer:PythonField ;
  mer:fieldOrder 3 ;
  mer:fieldName "connections" ;
  mer:fieldKind "list" ;
  mer:fieldPyType "Connection" ;
  mer:fieldDescription "List of connections between blocks" ;
  mer:fieldRenderFormat "  {_r1.source} {_r1.arrow_type} {_r1.target}" ;
  mer:fieldExampleValue "" .

mer:Model_Block a mer:PythonModel ;
  mer:className "Block" ;
  mer:isTopLevel false ;
  mer:field mer:Field_Block_id, mer:Field_Block_label .

mer:Field_Block_id a mer:PythonField ;
  mer:fieldOrder 1 ; mer:fieldName "id" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Block identifier" ;
  mer:fieldExampleValue "A" .

mer:Field_Block_label a mer:PythonField ;
  mer:fieldOrder 2 ; mer:fieldName "label" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Block label text" ;
  mer:fieldExampleValue "Module A" .

mer:Model_Connection a mer:PythonModel ;
  mer:className "Connection" ;
  mer:isTopLevel false ;
  mer:field mer:Field_Connection_source, mer:Field_Connection_target,
            mer:Field_Connection_arrow_type, mer:Field_Connection_label .

mer:Field_Connection_source a mer:PythonField ;
  mer:fieldOrder 1 ; mer:fieldName "source" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Source block ID" ;
  mer:fieldExampleValue "A" .

mer:Field_Connection_target a mer:PythonField ;
  mer:fieldOrder 2 ; mer:fieldName "target" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Target block ID" ;
  mer:fieldExampleValue "B" .

mer:Field_Connection_arrow_type a mer:PythonField ;
  mer:fieldOrder 3 ; mer:fieldName "arrow_type" ; mer:fieldKind "literal-default" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Arrow type (-->, <--, <-->, ===, --x, o--)" ;
  mer:fieldDefault "\"-->\"" ;
  mer:fieldExampleValue "-->" .

mer:Field_Connection_label a mer:PythonField ;
  mer:fieldOrder 4 ; mer:fieldName "label" ; mer:fieldKind "scalar-optional" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Optional connection label" ;
  mer:fieldExampleValue "" .

