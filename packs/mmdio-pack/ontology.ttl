# ----------------------------------------------------------------------------
# Pie (transcribed from models.py PieChart/PieSlice, render.py render_pie)
#
# NOTE: hand-written render_pie() inlines title into the header line
# ("pie title X" vs bare "pie"); the render template only supports a fixed
# header line plus separate optional lines below it (matching timeline's
# "timeline" + "title X" shape). Using the separate-line form here —
# verify against the real oracle below that mermaid-js still accepts
# "pie\ntitle X\n..." as valid pie syntax before trusting this.
# ----------------------------------------------------------------------------

mer:Type_pie mer:hasModel mer:Model_PieChart, mer:Model_PieSlice .

mer:Model_PieChart a mer:PythonModel ;
  mer:className "PieChart" ;
  mer:isTopLevel true ;
  mer:diagramHeaderKeyword "pie" ;
  mer:field mer:Field_PieChart_title, mer:Field_PieChart_slices .

mer:Field_PieChart_title a mer:PythonField ;
  mer:fieldOrder 1 ; mer:fieldName "title" ; mer:fieldKind "scalar-optional" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Optional chart title" ;
  mer:fieldRenderFormat "title {d.title}" ; mer:fieldExampleValue "Sales" .

mer:Field_PieChart_slices a mer:PythonField ;
  mer:fieldOrder 2 ; mer:fieldName "slices" ; mer:fieldKind "list" ;
  mer:fieldPyType "PieSlice" ; mer:fieldDescription "List of pie slices" ;
  mer:fieldRenderFormat "    \"{_r1.label}\" : {_r1.value}" ; mer:fieldExampleValue "" .

mer:Model_PieSlice a mer:PythonModel ;
  mer:className "PieSlice" ; mer:isTopLevel false ;
  mer:field mer:Field_PieSlice_label, mer:Field_PieSlice_value .

mer:Field_PieSlice_label a mer:PythonField ;
  mer:fieldOrder 1 ; mer:fieldName "label" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Slice label" ;
  mer:fieldExampleValue "Marketing" .

mer:Field_PieSlice_value a mer:PythonField ;
  mer:fieldOrder 2 ; mer:fieldName "value" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "float" ; mer:fieldDescription "Numeric value (percentage, count, or amount)" ;
  mer:fieldExampleValue "42.5" .

# ----------------------------------------------------------------------------
# Sankey (transcribed from models.py SankeyFlow/SankeyDiagram, render.py render_sankey)
#
# KNOWN GAP: hand-written render strips commas from source/target/label to
# avoid corrupting the CSV-style output (flow.source.replace(',', '')).
# The render-format vocabulary has no sanitization step — generated output
# will corrupt if a source/target/label example ever contains a literal
# comma. Not a concern for the example values chosen here, but a real gap
# for arbitrary user data, same category as block's label-branching gap.
# ----------------------------------------------------------------------------

mer:Type_sankey mer:hasModel mer:Model_SankeyDiagram, mer:Model_SankeyFlow .

mer:Model_SankeyDiagram a mer:PythonModel ;
  mer:className "SankeyDiagram" ;
  mer:isTopLevel true ;
  mer:diagramHeaderKeyword "sankey-beta" ;
  mer:field mer:Field_SankeyDiagram_flows .

mer:Field_SankeyDiagram_flows a mer:PythonField ;
  mer:fieldOrder 1 ; mer:fieldName "flows" ; mer:fieldKind "list" ;
  mer:fieldPyType "SankeyFlow" ; mer:fieldDescription "List of flows in the diagram" ;
  mer:fieldRenderFormat "    {_r1.source},{_r1.target},{_r1.value}" ; mer:fieldExampleValue "" .

mer:Model_SankeyFlow a mer:PythonModel ;
  mer:className "SankeyFlow" ; mer:isTopLevel false ;
  mer:field mer:Field_SankeyFlow_source, mer:Field_SankeyFlow_target, mer:Field_SankeyFlow_value .

mer:Field_SankeyFlow_source a mer:PythonField ;
  mer:fieldOrder 1 ; mer:fieldName "source" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Source node identifier" ;
  mer:fieldExampleValue "A" .

mer:Field_SankeyFlow_target a mer:PythonField ;
  mer:fieldOrder 2 ; mer:fieldName "target" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "str" ; mer:fieldDescription "Target node identifier" ;
  mer:fieldExampleValue "B" .

mer:Field_SankeyFlow_value a mer:PythonField ;
  mer:fieldOrder 3 ; mer:fieldName "value" ; mer:fieldKind "scalar-required" ;
  mer:fieldPyType "float" ; mer:fieldDescription "Flow value (determines width/thickness of flow)" ;
  mer:fieldExampleValue "100" .
