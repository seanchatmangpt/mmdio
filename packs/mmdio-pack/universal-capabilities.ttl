@prefix m: <https://seanchatmangpt.github.io/ontology/mermaid#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# All-dialect executable capability extension. The original deep model facts
# remain authoritative for their eleven domains; every catalog type also has
# a lossless typed CST and a pinned Mermaid JavaScript oracle subject.
m:Type_c4 a m:DiagramType ;
  m:diagramId "c4" ;
  m:documentClassName "C4Document" ;
  m:pythonEnumMember "C4" ;
  m:oracleExample "c4" ;
  m:oracleProfile "native" ;
  m:acceptedJsType "c4" .

