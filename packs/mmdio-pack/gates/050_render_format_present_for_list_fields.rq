PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
SELECT ?type ?field WHERE {
  ?type mer:pythonSupport true ; mer:renderStrategy "generic" ; mer:hasModel ?model .
  ?model mer:field ?field . ?field mer:fieldKind "list" .
  FILTER NOT EXISTS { ?field mer:fieldRenderFormat ?format }
}
