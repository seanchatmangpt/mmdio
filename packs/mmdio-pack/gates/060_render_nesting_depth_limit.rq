PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
SELECT ?type ?field WHERE {
  ?type mer:pythonSupport true ; mer:renderStrategy "generic" ; mer:hasModel ?top .
  ?top mer:isTopLevel true ; mer:field ?f1 . ?f1 mer:fieldKind "list" ; mer:fieldPyType ?t2 .
  ?m2 mer:className ?t2 ; mer:field ?f2 . ?f2 mer:fieldKind "list" ; mer:fieldPyType ?t3 .
  ?m3 mer:className ?t3 ; mer:field ?field . ?field mer:fieldKind "list" .
}
