PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
SELECT ?field ?fieldName ?fieldPyType WHERE {
  ?field a mer:PythonField ; mer:fieldKind ?kind ; mer:fieldName ?fieldName ; mer:fieldPyType ?fieldPyType .
  FILTER(?kind IN ("list", "nested-ref", "recursive-list"))
  FILTER NOT EXISTS { ?model a mer:PythonModel ; mer:className ?fieldPyType . }
}
