def build_dependency_matrix() -> DependencyMatrix:
    """Construct the full combinatorial dependency matrix."""
    matrix = DependencyMatrix(
        projects=PROJECTS,
        packages=list(set(pkg for deps in PROJECT_DEPENDENCIES.values() for pkg in deps.keys())),
        usage_matrix={},
        reverse_matrix={},
    )

    # Build project → packages mapping
    for project, dependencies in PROJECT_DEPENDENCIES.items():
        matrix.usage_matrix[project] = set(dependencies.keys())

    # Build package → projects reverse mapping
    for package in matrix.packages:
        matrix.reverse_matrix[package] = {
            project for project, deps in PROJECT_DEPENDENCIES.items()
            if package in deps
        }

    return matrix

def identify_version_conflicts(matrix: DependencyMatrix) -> Dict[str, Set[str]]:
    """Identify packages used across projects with version conflicts."""
    conflicts = {}
    for package, projects in matrix.reverse_matrix.items():
        if len(projects) > 1:
            versions = set()
            for project in projects:
                if package in PROJECT_DEPENDENCIES[project]:
                    versions.add(PROJECT_DEPENDENCIES[project][package])
            if len(versions) > 1:
                conflicts[package] = versions
    return conflicts

def categorize_by_domain(matrix: DependencyMatrix) -> Dict[str, Dict[str, int]]:
    """Stratify dependency matrix by semantic category."""
    category_stats = {}
    for category, packages in CATEGORIES.items():
        used_packages = [p for p in packages if p in matrix.packages]
        using_projects = set()
        for pkg in used_packages:
            using_projects.update(matrix.reverse_matrix.get(pkg, set()))

        category_stats[category] = {
            "packages_in_category": len(packages),
            "packages_used": len(used_packages),
            "projects_using": len(using_projects),
            "projects": sorted(list(using_projects)),
        }
    return category_stats

