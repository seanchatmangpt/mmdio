# SPARQL Gate: All projects are defined
# Validates that all 12 projects have RDF definitions
# Failure: Missing project definitions

PREFIX cyber: <http://cyberpunk.2030/>
PREFIX proj: <http://cyberpunk.2030/project/>

ASK {
  FILTER EXISTS {
    BIND(12 AS ?expected_count)
    {
      SELECT (COUNT(?project) AS ?actual_count) WHERE {
        ?project a cyber:Project .
      }
    }
    FILTER (?actual_count >= ?expected_count)
  }
}
