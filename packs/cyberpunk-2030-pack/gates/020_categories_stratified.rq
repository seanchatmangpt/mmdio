# SPARQL Gate: All packages are categorized
# Validates that packages are stratified into semantic categories
# Failure: Uncategorized packages remain

PREFIX cyber: <http://cyberpunk.2030/>
PREFIX pkg: <http://cyberpunk.2030/package/>
PREFIX cat: <http://cyberpunk.2030/category/>

ASK {
  # All exemplar packages must have a category
  ?package a cyber:Package ;
    cyber:category ?category .
  ?category a cyber:Category .
}
